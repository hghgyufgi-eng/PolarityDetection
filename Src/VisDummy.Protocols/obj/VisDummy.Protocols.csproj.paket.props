            <Version>8.0</Version>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging">
            <Version>8.0</Version>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug">
            <Version>8.0</Version>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging.EventLog">
            <Version>8.0</Version>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions">
            <Version>8.0</Version>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Diagnostics">
            <Version>8.0</Version>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging.Configuration">
            <Version>8.0</Version>
        </PackageReference>
        <PackageReference Include="StdUnit.One.Shared">
            <Version>0.2.20</Version>
        </PackageReference>
        <PackageReference Include="StdUnit.Sharp7.Options">
            <Version>0.6.3</Version>
        </PackageReference>
        <PackageReference Include="System.Formats.Asn1">
            <Version>9.0</Version>
