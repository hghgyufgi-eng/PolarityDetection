        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="($(DesignTimeBuild) == true) AND (($(TargetFrameworkIdentifier) == '.NETCoreApp' And ($(TargetFrameworkVersion) == 'v8.0' Or ($(TargetFrameworkVersion) == 'v7.0' And '$(TargetPlatformIdentifier)' == 'Windows' And '$(TargetPlatformVersion)' == '10.0.17763.0'))) Or ($(TargetFrameworkIdentifier) == '.NETStandard' And $(TargetFrameworkVersion) == 'v2.0'))">
        <PackageReference Include="Microsoft.NETCore.Targets">
            <Version>1.1.3</Version>
        </PackageReference>
        <PackageReference Include="System.Diagnostics.EventLog">
            <Version>8.0</Version>
        </PackageReference>
        <PackageReference Include="System.Security.Cryptography.Pkcs">
            <Version>9.0</Version>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="($(DesignTimeBuild) == true) AND (($(TargetFrameworkIdentifier) == '.NETFramework' And $(TargetFrameworkVersion) == 'v4.7.2') Or ($(TargetFrameworkIdentifier) == '.NETStandard' And $(TargetFrameworkVersion) == 'v2.0'))">
        <PackageReference Include="System.Buffers">
            <Version>4.5.1</Version>
        </PackageReference>
        <PackageReference Include="System.Memory">
            <Version>4.5.5</Version>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="($(DesignTimeBuild) == true) AND ($(TargetFrameworkIdentifier) == '.NETFramework' And $(TargetFrameworkVersion) == 'v4.7.2')">
        <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation">
            <Version>4.3</Version>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="($(DesignTimeBuild) == true) AND ($(TargetFrameworkIdentifier) == '.NETStandard' And $(TargetFrameworkVersion) == 'v2.0')">
        <PackageReference Include="System.Security.Cryptography.Cng">
            <Version>5.0</Version>
        </PackageReference>
    </ItemGroup>
</Project>