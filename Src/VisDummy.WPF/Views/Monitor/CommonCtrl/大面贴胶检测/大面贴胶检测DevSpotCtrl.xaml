<UserControl x:Class="VisDummy.WPF.Views.Monitor.CommonCtrl.大面贴胶检测.大面贴胶检测DevSpotCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:lang="clr-namespace:VisDummy.Lang;assembly=VisDummy.Lang"
             xmlns:common="clr-namespace:VisDummy.WPF.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisDummy.WPF.Views.Monitor.CommonCtrl.大面贴胶检测"
             mc:Ignorable="d"     
             x:Name="ele"
             d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="40" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontFamily" Value="NSimSun" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontFamily" Value="NSimSun" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontFamily" Value="NSimSun" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Height="40" Orientation="Horizontal">
        <common:LedSwitchCtrl
            IsChecked="{Binding DevMsg.CameraTrigger, ElementName=ele}"
            OffColor="Gray"
            OnColor="Orange"
            Tip="{Binding [精度校验拍照请求], Source={x:Static lang:LanguageManager.Instance}}" />
        <Label Content="{Binding [相机号], Source={x:Static lang:LanguageManager.Instance}}" />
        <TextBlock Text="{Binding DevMsg.CameraNo, ElementName=ele}" />
    </StackPanel>
</UserControl>
