<UserControl x:Class="VisDummy.WPF.Views.Monitor.CommonCtrl.大面贴胶检测.大面贴胶检测MstSpotCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lang="clr-namespace:VisDummy.Lang;assembly=VisDummy.Lang"
             xmlns:common="clr-namespace:VisDummy.WPF.Common"
             xmlns:local="clr-namespace:VisDummy.WPF.Views.Monitor.CommonCtrl.大面贴胶检测"
             mc:Ignorable="d" 
             x:Name="ele"
             d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="40" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontFamily" Value="NSimSun" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontFamily" Value="NSimSun" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontFamily" Value="NSimSun" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <StackPanel Height="40" Orientation="Horizontal">
            <common:LedSwitchCtrl
                IsChecked="{Binding MstMsg.Ack, ElementName=ele}"
                OffColor="Gray"
                OnColor="Blue"
                Tip="{Binding [精度校验拍照响应], Source={x:Static lang:LanguageManager.Instance}}" />
            <common:LedSwitchCtrl
                IsChecked="{Binding MstMsg.AckOk, ElementName=ele}"
                OffColor="Gray"
                OnColor="Green"
                Tip="{Binding [响应OK], Source={x:Static lang:LanguageManager.Instance}}" />
            <common:LedSwitchCtrl
                IsChecked="{Binding MstMsg.AckNg, ElementName=ele}"
                OffColor="Gray"
                OnColor="Red"
                Tip="{Binding [响应NG], Source={x:Static lang:LanguageManager.Instance}}" />
        </StackPanel>
        <StackPanel Height="40" Orientation="Horizontal">
            <Label Content="{Binding [特征大小], Source={x:Static lang:LanguageManager.Instance}}"  />
            <TextBlock Text="{Binding MstMsg.FeatureSize, ElementName=ele}" />
            <Label Content="{Binding [像素精度], Source={x:Static lang:LanguageManager.Instance}}" />
            <TextBlock Text="{Binding MstMsg.CameraPrecision, ElementName=ele}" />
        </StackPanel>
    </StackPanel>
</UserControl>
